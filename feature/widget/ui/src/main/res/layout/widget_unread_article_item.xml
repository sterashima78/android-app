<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/unread_widget_item"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:minHeight="82dp"
  android:orientation="vertical"
  android:paddingHorizontal="4dp"
  android:paddingVertical="8dp">

  <TextView
    android:id="@+id/unread_widget_item_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="2"
    android:textColor="@color/widget_text"
    android:textSize="14sp"
    android:textStyle="bold" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/unread_widget_item_meta"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:paddingEnd="6dp"
      android:textColor="@color/widget_text_secondary"
      android:textSize="11sp" />

    <TextView
      android:id="@+id/unread_widget_item_mark_read"
      android:layout_width="wrap_content"
      android:layout_height="32dp"
      android:background="@drawable/widget_action_background"
      android:contentDescription="@string/unread_widget_mark_read_description"
      android:gravity="center"
      android:minWidth="48dp"
      android:paddingHorizontal="10dp"
      android:text="@string/unread_widget_mark_read"
      android:textColor="@color/widget_accent"
      android:textSize="12sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/unread_widget_item_read_later"
      android:layout_width="wrap_content"
      android:layout_height="32dp"
      android:layout_marginStart="6dp"
      android:background="@drawable/widget_action_background"
      android:contentDescription="@string/unread_widget_read_later_description"
      android:gravity="center"
      android:minWidth="76dp"
      android:paddingHorizontal="10dp"
      android:text="@string/unread_widget_read_later"
      android:textColor="@color/widget_accent"
      android:textSize="12sp"
      android:textStyle="bold" />
  </LinearLayout>
</LinearLayout>
