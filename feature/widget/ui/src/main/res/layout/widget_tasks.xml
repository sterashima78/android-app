<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_background"
  android:orientation="vertical"
  android:padding="12dp">

  <LinearLayout
    android:id="@+id/task_widget_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingBottom="8dp">

    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="@string/task_widget_title"
      android:textColor="@color/widget_text"
      android:textSize="16sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/task_widget_refresh"
      android:layout_width="wrap_content"
      android:layout_height="36dp"
      android:contentDescription="@string/task_widget_refresh_description"
      android:gravity="center"
      android:minWidth="44dp"
      android:text="@string/task_widget_refresh"
      android:textColor="@color/widget_accent"
      android:textSize="20sp" />
  </LinearLayout>

  <FrameLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1">

    <ListView
      android:id="@+id/task_widget_list"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:divider="@color/widget_divider"
      android:dividerHeight="1dp"
      android:scrollbars="none" />

    <TextView
      android:id="@+id/task_widget_empty"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:gravity="center"
      android:padding="16dp"
      android:text="@string/task_widget_empty"
      android:textColor="@color/widget_text_secondary"
      android:textSize="14sp" />
  </FrameLayout>
</LinearLayout>
